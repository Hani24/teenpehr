{
  "name": "teenpehr-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:prepare": "tsx db/prepare.ts",
    "db:push": "npm run db:prepare && drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local db/seed.ts",
    "db:backfill": "tsx --env-file=.env.local db/backfill.ts",
    "user:invite": "tsx --conditions=react-server --env-file=.env.local scripts/invite.ts",
    "fonts": "bash scripts/fonts.sh"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "next-intl": "^4.14.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
