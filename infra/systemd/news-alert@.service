[Unit]
Description=Alert on failure of %i

[Service]
Type=oneshot
EnvironmentFile=%h/dev/teenpehr/worker/.env
ExecStart=/bin/sh -c '[ -n "$NTFY_TOPIC" ] || { echo "NTFY_TOPIC is not set in worker/.env; no alert sent for %i" >&2; exit 0; }; journalctl --user -u %i -n 40 --no-pager | curl -sS -H "Title: %i FAILED on $(hostname)" -H "Priority: high" --data-binary @- https://ntfy.sh/$NTFY_TOPIC'
