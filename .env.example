# Copy to web/.env.local (web) and worker/.env (worker). Never commit real values.

# --- shared ---
DATABASE_URL=postgres://teenpehr:teenpehr@127.0.0.1:5432/teenpehr
SITE_URL=http://localhost:3000
# Bearer token the worker presents to /api/worker/*. Generate: openssl rand -hex 32
WORKER_TOKEN=change-me

# --- worker only ---
# Claude runs through the Claude Code CLI signed in on this machine (the owner's Claude subscription),
# never an API key: sign in once as the user the timer runs as (`claude`, then /login). For the timer,
# a long-lived token is steadier: run `claude setup-token` and put the token here. An ANTHROPIC_API_KEY
# is ignored (the worker hides it from the CLI). Check with `uv run teenpehr health` (spends nothing).
CLAUDE_CODE_OAUTH_TOKEN=
NEWS_MODEL_CURATE=claude-sonnet-5
NEWS_MODEL_URDU=claude-opus-5-5
NEWS_MODEL_QA=claude-haiku-4-5-20251001
# SOCKS proxy to the Hetzner server for hosts blocked from Pakistan (see docs/PLAN.md)
GERMANY_PROXY=socks5h://127.0.0.1:1080
NTFY_TOPIC=
DRY_RUN=0

# --- accounts (web) ---
# The site is invite-only (docs/PLAN.md D2); ADMIN_PASSWORD is retired and no auth secret is needed:
# sessions and links are random tokens stored hashed in Postgres. The first owner's invite comes from
#   cd web && npm run user:invite -- --email you@example.com --role owner
# and later accounts from /admin/users. Links are built from SITE_URL, so set it to the public origin.
# In production the session cookie is Secure: serve the site over https (or http://localhost).
# The sign-in rate limit reads the last X-Forwarded-For hop, the address the nearest proxy saw: run the
# app behind exactly one reverse proxy that sets or appends it (the unit binds 127.0.0.1), or none.

# --- web only ---
# Absolute directory for the edition JSON snapshots written at publish. Unset: ~/.local/share/teenpehr/snapshots
# (never inside .next/, which every build wipes). infra/systemd/teenpehr-web.service sets the same default.
# EDITION_SNAPSHOT_DIR=/home/you/.local/share/teenpehr/snapshots
# Absolute directory for publisher images (POST /api/worker/images writes <sha256>-<w>.webp there; /media serves
# them to signed-in readers). Unset: ~/.local/share/teenpehr/media. The unit sets the same default.
# MEDIA_DIR=/home/you/.local/share/teenpehr/media
